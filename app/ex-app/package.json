{
  "name": "ex-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:baseline": "vite build --mode baseline",
    "build:optimized": "vite build --mode optimized",
    "build:compare": "run-s build:baseline build:optimized",
    "build:size-check": "node scripts/check-build-size.mjs",
    "build:analyze": "vite build --mode optimized",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "element-plus": "^2.11.9",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@open-design/components": "workspace:*",
    "@open-design/styles": "workspace:*",
    "@types/node": "^20.14.5",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/tsconfig": "^0.5.1",
    "cross-env": "^7.0.3",
    "less": "^4.5.1",
    "npm-run-all2": "^6.2.0",
    "postcss": "^8.4.47",
    "postcss-color-mix": "^1.1.0",
    "postcss-each": "^1.1.0",
    "postcss-each-variables": "^0.3.0",
    "postcss-for": "^2.1.1",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^6.2.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "terser": "^5.49.2",
    "typescript": "~5.7.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^5.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vue-tsc": "^2.0.21"
  }
}
